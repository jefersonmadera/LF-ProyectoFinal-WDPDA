{
  "title": "Configuración anidada",
  "type": "object",
  "properties": {
    "servicio": {
      "type": "object",
      "properties": {
        "nombre": { "type": "string" },
        "puertos": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 }, "uniqueItems": true },
        "replicas": { "type": "integer", "minimum": 1, "default": 1 },
        "entorno": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "limites": {
          "type": "object",
          "properties": { "cpu": { "type": "number" }, "memoria": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" } }
        }
      },
      "required": ["nombre"]
    },
    "etiquetas": { "type": "object", "additionalProperties": { "type": "string" }, "maxProperties": 10 }
  },
  "required": ["servicio"]
}
