{
  "title": "Combinadores",
  "type": "object",
  "properties": {
    "id": { "anyOf": [ { "type": "string", "minLength": 3 }, { "type": "integer", "minimum": 1 } ] },
    "forma": {
      "oneOf": [
        { "type": "object", "properties": { "tipo": { "const": "circulo" }, "radio": { "type": "number", "exclusiveMinimum": 0 } }, "required": ["tipo", "radio"] },
        { "type": "object", "properties": { "tipo": { "const": "rect" }, "ancho": { "type": "number" }, "alto": { "type": "number" } }, "required": ["tipo", "ancho", "alto"] }
      ]
    },
    "codigo": { "allOf": [ { "type": "string" }, { "minLength": 4 }, { "maxLength": 8 } ], "not": { "enum": ["0000", "1234"] } }
  },
  "required": ["id"]
}
