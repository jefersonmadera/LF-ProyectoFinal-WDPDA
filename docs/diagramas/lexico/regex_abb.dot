digraph "AFD mínimo de ^(a|b)*abb$ (4 estados, 5 antes de minimizar)" {
  rankdir=LR;
  node [shape=circle fontname="Helvetica" fontsize=11];
  edge [fontname="Helvetica" fontsize=9];
  __start [shape=point];
  __start -> "q0";
  "q0" [shape=circle];
  "q1" [shape=circle];
  "q2" [shape=circle];
  "q3" [shape=doublecircle];
  "q0" -> "q0" [label="b"];
  "q0" -> "q1" [label="a"];
  "q1" -> "q1" [label="a"];
  "q1" -> "q2" [label="b"];
  "q2" -> "q1" [label="a"];
  "q2" -> "q3" [label="b"];
  "q3" -> "q0" [label="b"];
  "q3" -> "q1" [label="a"];
}