digraph "AFD 2 (content): (nombre (correo | telefono))" {
  rankdir=LR;
  node [shape=circle fontname="Helvetica" fontsize=11];
  edge [fontname="Helvetica" fontsize=9];
  __start [shape=point];
  __start -> "q0";
  "q0" [shape=circle];
  "q1" [shape=circle];
  "q2" [shape=doublecircle];
  "q0" -> "q1" [label="nombre"];
  "q1" -> "q2" [label="correo,telefono"];
}